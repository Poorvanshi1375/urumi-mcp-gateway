  "type": "module",
  "description": "WooCommerce MCP server (Streamable HTTP, cluster-internal). Our own code; talks to the store over the Woo REST API v3.",
  "engines": { "node": ">=24" },
  "scripts": { "start": "node src/server.ts" },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@woocommerce/woocommerce-rest-api": "1.0.2",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
