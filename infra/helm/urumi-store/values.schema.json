{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "urumi-store values",
  "description": "Checked by helm lint, install and upgrade: a wrong type, an unknown enum value or a missing host fails before anything reaches the cluster. Unlisted keys are allowed (charts grow); the ones that matter are typed.",
  "type": "object",
  "definitions": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "url": {
      "type": "string",
      "pattern": "^(https?://[^\\s/]+(/.*)?)?$"
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "pinnedImage": {
      "allOf": [
        {
          "$ref": "#/definitions/image"
        },
        {
          "properties": {
            "tag": {
              "minLength": 1,
              "not": {
                "const": "latest"
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/cpuMemory"
        },
        "limits": {
          "$ref": "#/definitions/cpuMemory"
        }
      }
    },
    "cpuMemory": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/definitions/quantity"
        },
        "memory": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "uid": {
      "type": "integer",
      "minimum": 1
    },
    "podLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "store",
    "wordpress",
    "mysql",
    "setup",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "store": {
      "type": "object",
      "required": [
        "host",
        "title",
        "currency",
        "timezone"
      ],
      "properties": {
        "host": {
          "$ref": "#/definitions/host"
        },
        "homeUrl": {
          "$ref": "#/definitions/url"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "adminUser": {
          "type": "string",
          "minLength": 1
        },
        "adminEmail": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}(:[A-Z0-9]{1,3})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "seedProducts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "name",
              "price"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
              }
            }
          }
        }
      }
    },
    "woocommerce": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "apiKeyUser": {
          "type": "string",
          "minLength": 1
        },
        "pluginImage": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "wordpress": {
      "type": "object",
      "required": [
        "image",
        "persistence",
        "resources"
      ],
      "properties": {
        "runAsUser": {
          "$ref": "#/definitions/uid"
        },
        "image": {
          "$ref": "#/definitions/pinnedImage"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "mysql": {
      "type": "object",
      "required": [
        "image",
        "persistence",
        "resources"
      ],
      "properties": {
        "runAsUser": {
          "$ref": "#/definitions/uid"
        },
        "image": {
          "$ref": "#/definitions/pinnedImage"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "setup": {
      "type": "object",
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/pinnedImage"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "ingressController": {
          "type": "object",
          "required": [
            "podLabels"
          ],
          "properties": {
            "namespace": {
              "type": "string"
            },
            "podLabels": {
              "$ref": "#/definitions/podLabels"
            }
          }
        },
        "dns": {
          "type": "object",
          "required": [
            "podLabels"
          ],
          "properties": {
            "namespace": {
              "type": "string"
            },
            "podLabels": {
              "$ref": "#/definitions/podLabels"
            }
          }
        },
        "storeApiClients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "podLabels"
            ],
            "properties": {
              "podLabels": {
                "$ref": "#/definitions/podLabels"
              }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "signingBaseUrl": {
          "$ref": "#/definitions/url"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podLabels": {
              "$ref": "#/definitions/podLabels"
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "image": {
            "properties": {
              "tag": {
                "minLength": 1,
                "not": {
                  "const": "latest"
                }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "redirectHttp": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
