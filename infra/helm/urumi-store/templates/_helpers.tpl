{{/*
Expand the name of the chart.
*/}}
{{- define "urumi-store.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Create a default fully qualified app name.
We truncate at 63 chars because some Kubernetes name fields are limited to this (by the DNS naming spec).
If release name contains chart name it will be used as a full name.
*/}}
{{- define "urumi-store.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Create chart name and version as used by the chart label.
*/}}
{{- define "urumi-store.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Common labels
*/}}
{{- define "urumi-store.labels" -}}
helm.sh/chart: {{ include "urumi-store.chart" . }}
{{ include "urumi-store.selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{/*
Selector labels
*/}}
{{- define "urumi-store.selectorLabels" -}}
app.kubernetes.io/name: {{ include "urumi-store.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/*
Component labels: common labels plus a short `app` label (used by kubectl -l app=...).
Usage: include "urumi-store.componentLabels" (dict "ctx" . "component" "mysql")
*/}}
{{- define "urumi-store.componentLabels" -}}
{{ include "urumi-store.labels" .ctx }}
app.kubernetes.io/component: {{ .component }}
app: {{ .component }}
{{- end }}

{{- define "urumi-store.componentSelector" -}}
{{ include "urumi-store.selectorLabels" .ctx }}
app: {{ .component }}
{{- end }}

{{- define "urumi-store.secretName" -}}
{{- required "secrets.existingSecret is required: create the Secret with scripts/secrets.sh" .Values.secrets.existingSecret }}
{{- end }}

{{- define "urumi-store.mysqlHost" -}}
{{- printf "%s-mysql" (include "urumi-store.fullname" .) }}
{{- end }}

{{/*
Public home URL of the store. WooCommerce signs OAuth over this exact URL, port included.
*/}}
{{- define "urumi-store.homeUrl" -}}
{{- default (printf "http://%s" .Values.store.host) .Values.store.homeUrl | trimSuffix "/" }}
{{- end }}

{{/*
Env shared by the WordPress container and the WP-CLI setup Job. The Job loads the same
wp-config.php (generated by the WordPress image from these variables), so both need them.
*/}}
{{- define "urumi-store.wordpressEnv" -}}
- name: WORDPRESS_DB_HOST
  value: {{ include "urumi-store.mysqlHost" . | quote }}
- name: WORDPRESS_DB_NAME
  value: {{ .Values.mysql.database | quote }}
- name: WORDPRESS_DB_USER
  value: {{ .Values.mysql.user | quote }}
- name: WORDPRESS_DB_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "urumi-store.secretName" . }}
      key: mysql-password
- name: WORDPRESS_CONFIG_EXTRA
  value: |
    // Behind the Ingress, TLS ends at Traefik: trust its X-Forwarded-Proto so an https home URL
    // does not redirect in a loop. Only Traefik and woo-mcp can reach WordPress (NetworkPolicy),
    // and woo-mcp never sends this header (it signs requests over the http URL, KT D.4).
    if (($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https') { $_SERVER['HTTPS'] = 'on'; }
    define('WP_HOME', '{{ include "urumi-store.homeUrl" . }}');
    define('WP_SITEURL', '{{ include "urumi-store.homeUrl" . }}');
{{- end }}
